rules_version = '2';

// Blaze bucket: every byte costs money, so writes are size- and type-capped.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/projects/{projectId}/project.json {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/json.*');
    }

    match /users/{uid}/projects/{projectId}/thumbnail.jpg {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/projects/{projectId}/images/{imageId} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/renderSessions/{sessionId}/session.json {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/json.*');
    }

    match /users/{uid}/renderSessions/{sessionId}/thumbnail.jpg {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/renderSessions/{sessionId}/images/{imageId} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Owner can read and delete everything (so account deletion can sweep it); no other writes.
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow write: if false;
    }
  }
}
