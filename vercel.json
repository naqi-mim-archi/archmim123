{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 60 },
    "api/stripe-webhook.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/stripe-webhook", "destination": "/api/stripe-webhook" },
    { "source": "/api/(.*)", "destination": "/api?__path=/api/$1" }
  ]
}
