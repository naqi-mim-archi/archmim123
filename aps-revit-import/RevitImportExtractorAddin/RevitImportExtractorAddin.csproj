<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitTargetFramework Condition="'$(RevitTargetFramework)' == ''">net8.0-windows</RevitTargetFramework>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>false</UseWPF>
    <AssemblyName>OurApp.RevitImportExtractorAddin</AssemblyName>
    <RootNamespace>OurApp.RevitImportExtractorAddin</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <DesignAutomationRevitVersion Condition="'$(DesignAutomationRevitVersion)' == ''">2026.0.0</DesignAutomationRevitVersion>
    <RevitApiPackageVersion Condition="'$(RevitApiPackageVersion)' == ''">2026.0.0</RevitApiPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autodesk.Forge.DesignAutomation.Revit" Version="$(DesignAutomationRevitVersion)" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PackageContents.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="OurApp.RevitImportExtractorAddin.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
