# Copy to .env.local and fill in. Never commit .env.local or any service-account JSON.

# --- Google AI / Vertex -----------------------------------------------------
# Gemini API key (browser-side AI features): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Google Maps Platform key (Site Import map). Optional.
GOOGLE_MAPS_PLATFORM_KEY=
# Vertex AI service-account keys. Locally these are FILES (gitignored):
#   ml/auto_plan/rendair_gcp_key.json  -> project rendair-competitor (AI Render)
#   ml/auto_plan/gcp_key.json          -> text2plan / text4d-j backends
# On hosts without those files (Vercel), paste the same JSON into these variables instead:
GOOGLE_VERTEX_RENDER_SA_KEY_JSON=
GOOGLE_VERTEX_SA_KEY_JSON=
# Without either, renders and conversions fail with "Service account key not found".

# --- Self-hosted GPU renderer (gpu-renderer/README.md) ----------------------
# Empty = off: flux-2-pro / stable-diffusion-xl keep using Gemini.
UNIFIED_RENDERER_URL=
# UNIFIED_RENDERER_TIMEOUT_MS=300000
# UNIFIED_RENDERER_REQUIRE_AUTH=true

# --- Firebase (browser; this config is public by design) --------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database URL, for live cursors and presence. Enable Realtime Database in the
# Firebase console first. Leave blank to switch presence off entirely.
VITE_FIREBASE_DATABASE_URL=

# --- Firebase (server) ------------------------------------------------------
# Same as VITE_FIREBASE_PROJECT_ID; used to verify ID tokens.
FIREBASE_PROJECT_ID=
# Service-account JSON in single quotes. REQUIRED for billing (the ledger lives in Firestore).
FIREBASE_ADMIN_SA_KEY_JSON=
# 1 = skip the auth gate (local dev only)
ALLOW_ANONYMOUS_API=
# 1 = skip token charging on purpose
ALLOW_UNMETERED_API=

# --- Stripe -----------------------------------------------------------------
# sk_test_... for local. Do NOT use the live key here.
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen`, NOT the dashboard one.
STRIPE_WEBHOOK_SECRET=
# Where Stripe returns the buyer after checkout. Always set it in production.
APP_BASE_URL=http://localhost:3000

# --- Autodesk Platform Services (Revit export / import) ---------------------
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_REGION=US
APS_BUCKET_KEY=
APS_REVIT_ENGINE=Autodesk.Revit+2027
APS_REVIT_IMPORT_ENGINE=Autodesk.Revit+2027
APS_REVIT_IMPORT_APPBUNDLE_ID=
APS_REVIT_IMPORT_ACTIVITY_ID=
APS_REVIT_IMPORT_ACTIVITY_ALIAS=dev
APS_REVIT_APPBUNDLE_ID=
APS_REVIT_ACTIVITY_ID=
APS_REVIT_ACTIVITY_ALIAS=dev
APS_REVIT_ENGINE_2026=Autodesk.Revit+2026
APS_REVIT_APPBUNDLE_ID_2026=
APS_REVIT_ACTIVITY_ID_2026=
APS_REVIT_ACTIVITY_ALIAS_2026=dev

# --- Roboflow (wall detection) ----------------------------------------------
ROBOFLOW_WALL_API_KEY=
ROBOFLOW_WALL_WORKSPACE=
ROBOFLOW_WALL_WORKFLOW_ID=
